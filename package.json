{
  "name": "gpt-to-minimax",
  "version": "1.0.0",
  "private": true,
  "bin": {
    "g2m": "dist/cli/index.js"
  },
  "type": "module",
  "description": "G2M — a local coding orchestrator that lets Codex (high-intelligence Planner/Reviewer) safely delegate coding work to MiniMax Code and verify results with real engineering evidence. See _skill/docs/GPT-to-MMX-v1-实施计划书.md.",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "g2m": "npm run build --silent && node dist/cli/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:lease-process": "npm run build --silent && node --test tests/process/workspace-lease.process.e2e.mjs",
    "test:process-supervisor": "npm run build --silent && node --test tests/process/process-supervisor.process.e2e.mjs",
    "test:storage-process": "npm run build --silent && node --test tests/process/storage-reservation.process.e2e.mjs"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "cross-spawn": "^7.0.6",
    "zod": "^4.5.2"
  }
}
